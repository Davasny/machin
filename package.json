{
  "name": "machin",
  "version": "2.0.0-rc1",
  "description": "TypeScript state machine library with first-class persistence support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./drizzle": {
      "import": "./dist/adapters/drizzle/index.js",
      "types": "./dist/adapters/drizzle/index.d.ts"
    },
    "./drizzle/pg": {
      "import": "./dist/adapters/drizzle/pg.js",
      "types": "./dist/adapters/drizzle/pg.d.ts"
    },
    "./drizzle/sqlite": {
      "import": "./dist/adapters/drizzle/sqlite.js",
      "types": "./dist/adapters/drizzle/sqlite.d.ts"
    },
    "./redis": {
      "import": "./dist/adapters/redis.js",
      "types": "./dist/adapters/redis.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "vitest run --typecheck",
    "test:release": "node .github/scripts/validate-version.test.cjs",
    "lint": "tsc --noEmit",
    "check": "biome check . && pnpm lint && pnpm test",
    "publish:local": "yalc publish"
  },
  "keywords": [
    "state-machine",
    "typescript",
    "persistence",
    "drizzle",
    "redis"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Davasny/machin.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@libsql/client": "0.17.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.3.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "redis": "6.2.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "uuid": "14.0.2",
    "vitest": "4.1.11",
    "yalc": "1.0.0-pre.53"
  },
  "peerDependencies": {
    "redis": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.0.0"
}
